{
  "permissions": {
    "allow": [
      "Bash(npx playwright test:*)"
    ],
    "deny": [],
    "ask": []
  },
  "enabledMcpjsonServers": [
    "serena"
  ],
  "hooks": {
    "session-start": [
      "/serena-auto"
    ],
    "assistant-response-end": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ny/work/00_bot_list/.claude/notify_completion.sh \"作業完了・入力待ち\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ny/work/00_bot_list/.claude/notify_completion.sh \"作業完了・入力待ち\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ny/work/00_bot_list/.claude/notify_completion.sh \"入力を待っています\""
          }
        ]
      }
    ]
  }
}
